        "query": "SELECT platform, access_token, refresh_token, expires_at, extra FROM tokens;",
        "options": {}
      },
      "id": "a4000001-0000-4000-8000-000000000016",
      "name": "Load Tokens Refresh",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 320],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Refresh token TikTok (POST form) & Instagram (GET ig_refresh_token).\nconst out = [];\nfor (const item of $input.all()) {\n  const t = item.json;\n  if (t.platform === 'tiktok') {\n    const body = new URLSearchParams({\n      client_key: $env.TIKTOK_CLIENT_KEY || '',\n      client_secret: $env.TIKTOK_CLIENT_SECRET || '',\n      grant_type: 'refresh_token',\n      refresh_token: t.refresh_token || ''\n    }).toString();\n    out.push({\n      json: {\n        platform: 'tiktok',\n        method: 'POST',\n        url: 'https://open.tiktokapis.com/v2/oauth/token/',\n        contentType: 'application/x-www-form-urlencoded',\n        body,\n        headers: []\n      }\n    });\n  } else if (t.platform === 'instagram') {\n    out.push({\n      json: {\n        platform: 'instagram',\n        method: 'GET',\n        url: 'https://graph.facebook.com/v21.0/oauth/access_token?grant_type=ig_refresh_token&fb_exchange_token=' + encodeURIComponent(t.access_token),\n        contentType: '',\n        body: '',\n        headers: []\n      }\n    });\n  }\n}\nreturn out;"
      },
      "id": "a4000001-0000-4000-8000-000000000017",
      "name": "Build Refresh Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 320]
    },
    {
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "={{ $json.contentType || 'application/json' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a4000001-0000-4000-8000-000000000018",
      "name": "Refresh Tokens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 320],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Simpan hasil refresh (toleran: kalau gagal, token lama tetap dipakai).\nconst req = $('Build Refresh Requests').item.json;\nconst res = $json;\nconst nowSec = Math.floor(Date.now() / 1000);\nconst out = [];\nif (req.platform === 'tiktok' && res.access_token) {\n  const exp = new Date((nowSec + (res.expires_in || 86400)) * 1000).toISOString();\n  out.push({ json: { platform: 'tiktok', access: res.access_token, refresh: res.refresh_token || '', exp } });\n} else if (req.platform === 'instagram' && res.access_token) {\n  const exp = new Date((nowSec + (res.expires_in || 60 * 86400)) * 1000).toISOString();\n  out.push({ json: { platform: 'instagram', access: res.access_token, refresh: '', exp } });\n}\nreturn out;"
      },
      "id": "a4000001-0000-4000-8000-000000000019",
      "name": "Parse Refresh Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 320]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tokens SET access_token = $1, refresh_token = CASE WHEN $2 = '' THEN refresh_token ELSE $2 END, expires_at = $3, updated_at = now() WHERE platform = $4;",
        "options": {
          "queryReplacement": "={{ [ $json.access, $json.refresh, $json.exp, $json.platform ] }}"
        }
      },
      "id": "a4000001-0000-4000-8000-000000000020",
      "name": "Save Refreshed Tokens",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1100, 320],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres"
        }
      }
    }
