      "id": "a4000001-0000-4000-8000-000000000010",
      "name": "IG Create Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, -60],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Catat submit ke posts + tandai script posted.\nconst ctx = $('Build Requests').first().json;\nconst tt = $('TikTok Inbox Init').first().json || {};\nconst ig = $('IG Create Container').first().json || {};\nconst out = [];\n\nconst ttOk = !!(tt.data && tt.data.publish_id);\nconst ttErr = ttOk ? null : JSON.stringify(tt).slice(0, 500);\nconst igOk = !!(ig.id || ig.creation_id);\nconst igErr = igOk ? null : JSON.stringify(ig).slice(0, 500);\nconst igContainerId = ig.id || ig.creation_id || null;\n\nout.push({\n  json: {\n    sql: `INSERT INTO posts (script_id, platform, external_id, status, error, posted_at) VALUES (${ctx.script_id}, 'tiktok', '${ttOk ? tt.data.publish_id : ''}', '${ttOk ? 'submitted' : 'failed'}', ${ttErr ? \"'\" + ttErr.replace(/'/g, \"''\") + \"'\" : 'NULL'}, now());`\n  }\n});\nout.push({\n  json: {\n    sql: `INSERT INTO posts (script_id, platform, external_id, status, error, posted_at) VALUES (${ctx.script_id}, 'instagram', '${igOk ? igContainerId : ''}', '${igOk ? 'submitted' : 'failed'}', ${igErr ? \"'\" + igErr.replace(/'/g, \"''\") + \"'\" : 'NULL'}, now());`\n  }\n});\nreturn out;"
      },
