    {
      "parameters": {
        "jsCode": "// Gabungkan script + token; siapkan request pertama TikTok (creator_info).\nconst script = $('Pick Approved').first().json;\nconst tokens = {};\nfor (const t of $input.all()) {\n  if (t.json.platform) tokens[t.json.platform] = t.json;\n}\nconst tt = tokens.tiktok;\nconst ig = tokens.instagram;\nif (!tt || !tt.access_token) throw new Error('Token TikTok belum diisi di tabel tokens');\nif (!ig || !ig.access_token) throw new Error('Token Instagram belum diisi di tabel tokens');\n\nconst hashtags = /#[\\w]+/.test(script.caption || '') ? '' : '#fyp #viral #rekomendasi';\nconst caption = ((script.title || script.hook || '') + '\\n\\n' + (script.caption || '') + ' ' + hashtags + '\\n\\nLink di bio 🔗').trim().slice(0, 2000);\nconst videoUrl = $env.PUBLIC_MEDIA_URL + script.media_file;\n\nreturn {\n  json: {\n    script_id: script.id,\n    media_file: script.media_file,\n    video_url: videoUrl,\n    caption,\n    tt_access: tt.access_token,\n    ig_access: ig.access_token,\n    ig_user_id: (ig.extra && (ig.extra.ig_user_id || ig.extra.user_id)) || null\n  }\n};"
      },
      "id": "a4000001-0000-4000-8000-000000000006",
      "name": "Prepare Publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/creator_info/query/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.tt_access }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a4000001-0000-4000-8000-000000000007",
      "name": "TikTok Creator Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -60]
    },
    {
      "parameters": {
        "jsCode": "// Bangun payload TikTok (mode inbox) + IG container.\nconst ctx = $('Prepare Publish').first().json;\nconst info = ($json.data && $json.data.creator_info) || {};\nconst opts = info.privacy_level_options || ['SELF_ONLY'];\nconst privacy = opts.includes('PUBLIC_TO_EVERYONE') ? 'PUBLIC_TO_EVERYONE' : opts[0];\n\nconst tiktokInit = {\n  post_info: {\n    title: ctx.caption.slice(0, 2200),\n    privacy_level: privacy,\n    disable_duet: false,\n    disable_stitch: false,\n    disable_comment: false\n  },\n  source_info: {\n    source: 'PULL_FROM_URL',\n    video_url: ctx.video_url\n  }\n};\n\nconst igContainer = {\n  media_type: 'REELS',\n  video_url: ctx.video_url,\n  caption: ctx.caption.slice(0, 2000),\n  share_to_feed: true\n};\n\nreturn {\n  json: {\n    ...ctx,\n    privacy,\n    tiktokInit,\n    igContainer,\n    tt_access: ctx.tt_access,\n    ig_access: ctx.ig_access,\n    ig_user_id: ctx.ig_user_id\n  }\n};"
      },
      "id": "a4000001-0000-4000-8000-000000000008",
      "name": "Build Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/inbox/video/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.tt_access }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.tiktokInit) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a4000001-0000-4000-8000-000000000009",
      "name": "TikTok Inbox Init",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -60],
