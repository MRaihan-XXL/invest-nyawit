      "name": "Advance Offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\nif (!res || res.ok !== true) {\n  console.log('getUpdates non-ok: ' + JSON.stringify(res).slice(0, 200));\n  return [];\n}\nconst updates = Array.isArray(res.result) ? res.result : [];\nif (updates.length === 0) return [];\nlet maxId = Number(sd.tgOffset || 0);\nfor (const u of updates) {\n  const id = Number(u.update_id || 0);\n  if (id >= maxId) maxId = id + 1;\n}\nsd.tgOffset = maxId;\nreturn updates.map(u => ({ json: u }));"
      }
