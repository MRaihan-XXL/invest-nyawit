      "id": "a3000001-0000-4000-8000-000000000014",
      "name": "Activate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, -40]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE strategy SET active = (id = $1), approved_at = CASE WHEN id = $1 THEN now() ELSE approved_at END WHERE active = true OR id = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.strategy_id ] }}"
        }
      },
      "id": "a3000001-0000-4000-8000-000000000015",
