      {
        "id": "a3000001-0000-4000-8000-000000000008",
        "name": "Parse Product Command",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          120
        ],
        "parameters": {
          "jsCode": "// Mode manual-seed: /produk <url_afiliasi> <harga> <judul...>\n// route: 'skip' = bukan /produk atau bukan pemilik (diam)\n//        'help' = pemilik, format salah\n//        'seed' = pemilik, format benar\nconst msg = $json.message || {};\nconst chatId = String((msg.chat && msg.chat.id) || '');\nconst text = (msg.text || '').trim();\nconst owner = String($env.TELEGRAM_CHAT_ID || '');\nconst authorized = chatId === owner && owner !== '';\n\nif (!text.startsWith('/produk')) {\n  return { json: { route: 'skip' } };\n}\n\nconst parts = text.split(/\\s+/);\nconst url = parts[1] || '';\nconst price = parseInt(parts[2], 10);\nconst title = parts.slice(3).join(' ').trim();\nconst valid = /^https?:\\/\\//.test(url) && Number.isFinite(price) && price > 0 && title.length >= 3;\n\nif (!authorized) {\n  return { json: { route: 'skip' } };\n}\n\nreturn {\n  json: {\n    route: valid ? 'seed' : 'help',\n    chat_id: chatId,\n    message_id: msg.message_id || 0,\n    url,\n    price: Number.isFinite(price) ? price : null,\n    title,\n    help: 'Format: /produk <url_afiliasi> <harga> <judul>\\nContoh:\\n/produk https://shopee.co.id/xxx 150000 Power Bank 20000mAh'\n  }\n};"
        }
