    },
    {
      "parameters": {
        "jsCode": "// Parse callback: \"approve:<id>\" / \"reject:<id>\" (naskah) dan\n// \"strategy:<id>\" / \"strategy-discard:<id>\" (analitik) — hanya pemilik chat yang sah.\nconst cq = $json.callback_query || {};\nconst data = cq.data || '';\nconst chatId = String((cq.from && cq.from.id) || '');\nconst m = data.match(/^(approve|reject):(\\d+)$/);\nconst ms = data.match(/^strategy(-discard)?:(\\d+)$/);\nconst owner = String($env.TELEGRAM_CHAT_ID || '');\nconst authorized = (!!m || !!ms) && chatId === owner;\nreturn {\n  json: {\n    callback_id: cq.id,\n    kind: m ? 'script' : (ms ? 'strategy' : null),\n    action: m ? m[1] : (ms ? (ms[1] ? 'strategy-discard' : 'strategy') : null),\n    script_id: m ? Number(m[2]) : null,\n    strategy_id: ms ? Number(ms[2]) : null,\n    authorized,\n    requester: chatId\n  }\n};"
      },
      "id": "a3000001-0000-4000-8000-000000000002",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3000001-0000-4000-8000-000000000003",
      "name": "Owner?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
