      "name": "Should Help?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO products (source, ext_id, track, title, offer_url, price_min, status, score)\nVALUES ('manual', md5($1), 'id', $2, $1, $3, 'new', 75)\nON CONFLICT (source, ext_id)\nDO UPDATE SET\n  title = EXCLUDED.title,\n  offer_url = EXCLUDED.offer_url,\n  price_min = COALESCE(EXCLUDED.price_min, products.price_min),\n  updated_at = now()\nRETURNING id, title, offer_url, price_min;",
        "options": {
          "queryReplacement": "={{ [ $json.url, $json.title, $json.price ] }}"
        }
      },
      "id": "a3000001-0000-4000-8000-00000000000b",
      "name": "Insert Product",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 40],
