    {
      "id": "a5000001-0000-4000-8000-000000000002",
      "name": "Build Report Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Tarik laporan konversi Shopee (dijalankan HARIAN, jendela 7 hari untuk jaring pengaman\n// kalau 1 hari gagal). Duplikat ditahan unique index (checkout_id, ts) di tabel conversions.\nconst crypto = require('crypto');\nconst appid = $env.SHOPEE_AFFILIATE_APPID;\nconst secret = $env.SHOPEE_AFFILIATE_SECRET;\nif (!appid || !secret) throw new Error('SHOPEE_AFFILIATE_APPID/SECRET belum diisi');\n\nconst end = Math.floor(Date.now() / 1000);\nconst start = end - 7 * 24 * 3600;\nconst query = `{\n  conversionReport(purchaseTimeStart: ${start}, purchaseTimeEnd: ${end}, scrollId: \"\", limit: 500, orderStatus: ALL) {\n    nodes {\n      checkoutId\n      purchaseTime\n      estimatedTotalCommission\n      grossCommission\n      cappedCommission\n      totalBrandCommission\n    }\n    pageInfo { scrollId hasNextPage }\n  }\n}`;\nconst body = JSON.stringify({ query });\nconst ts = Math.floor(Date.now() / 1000);\nconst sign = crypto.createHash('sha256').update(appid + String(ts) + body + secret).digest('hex');\nreturn {\n  json: {\n    body,\n    auth: `SHA256 Credential=${appid}, Signature=${sign}, Timestamp=${ts}`,\n    start,\n    end\n  }\n};"
      }
    },
    {
      "id": "a5000001-0000-4000-8000-000000000003",
      "name": "Shopee conversionReport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open-api.affiliate.shopee.co.id/graphql",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.auth }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "a5000001-0000-4000-8000-000000000004",
      "name": "Aggregate Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Agregat + simpan ke tabel conversions + siap ringkasan Telegram.\nconst rep = ($json.data && $json.data.conversionReport) || {};\nconst nodes = rep.nodes || [];\nlet total = 0;\nconst rows = [];\nconst esc = s => String(s ?? '').replace(/'/g, \"''\");\nfor (const n of nodes) {\n  const comm = Number(n.estimatedTotalCommission || 0);\n  total += comm;\n  rows.push(`('${esc(n.checkoutId)}', ${comm}, to_timestamp(${Number(n.purchaseTime || 0)}), '${esc(JSON.stringify(n))}')`);\n}\nlet sql = 'SELECT 1';\nif (rows.length) {\n  sql = `INSERT INTO conversions (checkout_id, commission, ts, raw) VALUES ${rows.join(',')} ON CONFLICT DO NOTHING;`;\n}\nconst hasMore = !!(rep.pageInfo && rep.pageInfo.hasNextPage);\nreturn {\n  json: {\n    sql,\n    orders: nodes.length,\n    total_commission: Math.round(total * 100) / 100,\n    has_more: hasMore\n  }\n};"
      }
    },
    {
      "id": "a5000001-0000-4000-8000-000000000005",
      "name": "Save Conversions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "tOnurKW7p4nLpOy5",
          "name": "Postgres"
        }
      }
    },
    {
      "id": "a5000001-0000-4000-8000-000000000012",
      "name": "Build Weekly SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        220
      ],
      "parameters": {
        "jsCode": "// Ringkasan mingguan dihitung dari DB (data sudah ditarik harian) — tidak tarik API dua kali.\nreturn {\n  json: {\n    sql: \"SELECT COALESCE(SUM(commission),0)::numeric(14,2) AS total, COUNT(*)::int AS orders FROM conversions WHERE ts >= now() - interval '7 days'\"\n  }\n};"
      }
    },
    {
