# invest-nyawit — salin ke .env lalu isi. JANGAN commit .env berisi nilai asli.

# ---- Server ----
DOMAIN=investmu.duckdns.org
TZ=Asia/Jakarta
DUCKDNS_TOKEN=isi-token-duckdns-kamu
N8N_ENCRYPTION_KEY=acak-32-karakter-hex

# ---- Database ----
POSTGRES_DB=investnyawit
POSTGRES_USER=nyawit
POSTGRES_PASSWORD=ganti-ini-punya-kamu

# ---- LLM (OpenAI-compatible) ----
# Contoh: https://openrouter.ai/api/v1  + key OpenRouter (ada model gratis)
# atau     https://api.groq.com/openai/v1
# atau     http://host.docker.internal:11434/v1  (Ollama lokal, key bebas)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=isi-key
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ---- Shopee Affiliate Open API ----
# Daftar: https://affiliate.shopee.co.id → Open API → buat aplikasi
SHOPEE_AFFILIATE_APPID=
SHOPEE_AFFILIATE_SECRET=

# ---- TikTok Developer (Content Posting API — mode inbox) ----
# Daftar: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Instagram Graph API ----
# Buat app di https://developers.facebook.com → tambah product Instagram Graph API
IG_APP_ID=
IG_APP_SECRET=

# ---- Telegram approval bot ----
# Buat via @BotFather → /newbot → token; chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Pipeline ----
AI_GATE_MIN=70
POSTS_PER_DAY_ID=4
POSTS_PER_DAY_EN=2
HANDLE_ID=@primefinds.id
HANDLE_EN=@yourchannel

# ---- Dashboard (https://DOMAIN/stats — basic auth) ----
# Hash: jalankan (dari root folder ini):
#   docker compose --env-file .env -f server/docker-compose.yml run --rm --no-deps caddy caddy hash-password --plaintext 'kata-sandi-pilihmu'
# lalu tempel hasilnya di bawah. WAJIB kutip satu ('...'): tanda $ di dalam hash
# bcrypt akan di-interpolasi docker compose kalau tanpa kutip.
STATS_USER=admin
BASIC_AUTH_HASH='$2a$12$G1anexamplehashplaceholderG1anexamplehashG1anexa'
